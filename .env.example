# Docker Compose PostgreSQL settings
POSTGRES_DB=festival_hub
POSTGRES_USER=festival_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application secrets
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-long-random-password
CLAIM_DEVICE_SECRET=replace-with-at-least-32-random-characters

# Bind to loopback when using a reverse proxy. Set 0.0.0.0 only when needed.
SERVER_BIND=127.0.0.1
APP_PORT=3000
DATABASE_POOL_MAX=10

# For running the app directly instead of through Docker Compose:
DATABASE_URL=postgresql://festival_hub:password@127.0.0.1:5432/festival_hub

# Only used by the optional database integration test:
TEST_DATABASE_URL=
