# Docker Compose PostgreSQL settings
POSTGRES_DB=festival_hub
POSTGRES_USER=festival_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Application secrets
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-long-random-password
CLAIM_DEVICE_SECRET=replace-with-at-least-32-random-characters

# Production image published by GitHub Actions
APP_IMAGE=ghcr.io/guis-tst-hub/festival-achievement-hub:v0.7.1

# Network mode. For HTTPS reverse proxy use 127.0.0.1 + true.
# For temporary direct LAN HTTP use 0.0.0.0 + false. Direct mode keeps the
# per-device claim limit but disables address-based limiting because there is
# no trusted proxy supplying the client address.
SERVER_BIND=127.0.0.1
APP_PORT=3000
DATABASE_POOL_MAX=20
TRUST_PROXY_HEADERS=false

# For running the app directly instead of through Docker Compose:
DATABASE_URL=postgresql://festival_hub:password@127.0.0.1:5432/festival_hub

# Only used by the optional database integration test:
TEST_DATABASE_URL=
