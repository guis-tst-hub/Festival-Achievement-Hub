# Copy this file to the repository root as `.env` on the school test server.
# Never commit the resulting `.env` file.

APP_IMAGE=ghcr.io/guis-tst-hub/festival-achievement-hub:v0.7.1

POSTGRES_DB=festival_hub
POSTGRES_USER=festival_hub
POSTGRES_PASSWORD=replace-with-a-long-random-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-different-long-random-password
CLAIM_DEVICE_SECRET=replace-with-at-least-32-random-characters

# Optional. Required only for the admin-panel GitHub update button.
GITHUB_UPDATE_TOKEN=
GITHUB_UPDATE_REPOSITORY=guis-tst-hub/Festival-Achievement-Hub
GITHUB_UPDATE_WORKFLOW=deploy-school.yml
GITHUB_UPDATE_REF=main

# Direct LAN HTTP test mode. Camera APIs still require trusted HTTPS on phones.
SERVER_BIND=0.0.0.0
APP_PORT=3001
DATABASE_POOL_MAX=20
TRUST_PROXY_HEADERS=false
